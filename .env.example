# ─── Telegram ────────────────────────────────────────────
TELEGRAM_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
TELEGRAM_WEBHOOK_SECRET=generate-a-random-32-char-string-here
ALLOWED_CHAT_IDS=123456789,987654321

# ─── Gemini (Agent Brain) ────────────────────────────────
# Get a free API key: https://aistudio.google.com/apikey
# Free tier: 1,500 req/day, no credit card needed
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30.0

# ─── Ollama (Local LLM for RAG) ──────────────────────────
# All inference runs locally via Ollama — no cloud API costs.
# Install: https://ollama.com
# Pull models:
#   ollama pull qwen3:4b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=60.0

# ─── RAG Settings ────────────────────────────────────────
# Directory where study documents (PDFs, text files) are stored
DOCS_DIR=app/docs
# Chunk size for document indexing
CHUNK_SIZE=512
CHUNK_OVERLAP=50
# Top-K chunks to retrieve per query
RETRIEVAL_TOP_K=5

# ─── Database ────────────────────────────────────────────
DB_PATH=data/magic-grimoire.db

# ─── AI Personality ──────────────────────────────────────
AI_PERSONALITY=friendly, helpful, knowledgeable tutor
